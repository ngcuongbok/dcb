{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dcb",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/viewer",
      "/viewer/",
      "/viewer/index.html",
      "/viewer-preview-warm"
    ]
  },
  "main": "worker.mjs",
  "kv_namespaces": [
    { "binding": "OG_PREVIEWS", "id": "3644510d88fe4e1e8ac962efa8382c3d" }
  ]
}
