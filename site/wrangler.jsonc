{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dcb",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/viewer",
      "/viewer/",
      "/viewer/index.html"
    ]
  },
  "main": "worker.mjs"
}
